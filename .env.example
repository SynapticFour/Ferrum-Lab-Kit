# Ferrum Lab Kit — local stack environment (copy to `.env` next to generated compose).
# Used by docker compose variable substitution. See docs/OPERATIONS-CHECKLIST.md.

# --- Ferrum monolith (required for default path) ---
# x86_64 / amd64:
FERRUM_IMAGE=ghcr.io/synapticfour/ferrum:latest
# Raspberry Pi / ARM64 (if published):
# FERRUM_IMAGE=ghcr.io/synapticfour/ferrum:latest-arm64
FERRUM_PORT=8080
FERRUM_DATA_DIR=$HOME/.ferrum

# --- ga4gh-infra co-deploy (make up-with-infra / --with-ga4gh-infra) ---
GA4GH_IMAGE_PREFIX=ghcr.io/synapticfour
MOCK_IDP_VERSION=0.1.0
VISA_REGISTRY_VERSION=0.1.0
DUO_SERVICE_VERSION=0.1.0
SERVICE_REGISTRY_VERSION=0.1.0
ACCESS_DECISION_SERVICE_VERSION=0.1.0
AAI_BROKER_VERSION=0.1.0
# Paths relative to the compose working directory (usually repo root):
GA4GH_INFRA_CONFIG_DIR=deploy/docker-compose/ga4gh-infra-config
GA4GH_INFRA_SECRETS_DIR=deploy/docker-compose/ga4gh-infra-secrets

# External ga4gh-infra (mode = "external") — host-reachable URLs:
# GA4GH_EXTERNAL_JWKS_URL=http://127.0.0.1:8180/jwks.json
# GA4GH_EXTERNAL_ISSUER=http://127.0.0.1:8180
# GA4GH_EXTERNAL_REGISTRY_URL=http://127.0.0.1:8183

# --- Solum companion (make up-with-solum / --with-solum) ---
SOLUM_PORT=8787
SOLUM_SIDECAR_TOKEN=solum-lab-kit-local-token-change-me
SOLUM_ALLOW_EPHEMERAL=1
SOLUM_TAG=stage1-baseline-sidecar-custody-2026-08-01
# Optional: use a prebuilt image instead of building Dockerfile.solum-sidecar
# SOLUM_IMAGE=ghcr.io/example/solum-sidecar:tag
SOLUM_DOCKER_CONTEXT=deploy/docker-compose
FERRUM_SOLUM_TIMEOUT_SECS=5

# --- CLI helpers ---
# FERRUM_GATEWAY_URL=http://127.0.0.1:8080
# FERRUM_TOKEN=
# FERRUM_BIN=ferrum
# HELIXTEST_BIN=helixtest
# FERRUM_LAB_KIT_LICENSE_KEY=
